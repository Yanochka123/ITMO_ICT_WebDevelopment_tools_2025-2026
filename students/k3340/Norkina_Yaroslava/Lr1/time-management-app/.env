# time-manager-app/.env
# Этот файл используется ТОЛЬКО Docker Compose.
# Внутри контейнеров DB_HOST=postgres — имя сервиса, не localhost.

DB_HOST=postgres
DB_PORT=5432
DB_NAME=time_management_db
DB_USER=postgres
DB_PASSWORD=135papin

SECRET_KEY=135papin
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Для PostgreSQL-контейнера (официальный образ postgres)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=135papin
POSTGRES_DB=time_management_db